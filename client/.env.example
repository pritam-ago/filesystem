# Copy this file to .env.local and adjust if needed:
#   cp .env.example .env.local
#
# The default below is correct for the standard local setup.

# Base URL of the Express API, including the /api path prefix.
# The server listens on 3000 (server/.env PORT) and this client runs on 5000,
# so these must not be the same port.
#
# In production point this at your deployed API, e.g.
#   https://filesystem.up.railway.app/api
#
# NEXT_PUBLIC_ vars are inlined into the browser bundle at build time, so this
# must never hold a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

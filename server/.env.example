# Copy this file to .env and fill in the blanks:
#   cp .env.example .env
#
# The defaults below match docker-compose.yml, so with `docker compose up -d`
# running you only need to supply JWT_SECRET.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on. Railway and most PaaS hosts inject this themselves.
PORT=3000

# Comma-separated list of browser origins allowed to call this API.
# Must include wherever the Next client is served from (it runs on 5000).
CORS_ORIGINS=http://localhost:5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# From `docker compose up -d`. For MongoDB Atlas instead, use the SRV string
# from Atlas > Cluster > Connect > Drivers.
# If you already run mongod on 27017 and started compose with MONGO_PORT=27018,
# point this at 27018 instead.
MONGODB_URI=mongodb://127.0.0.1:27017/folder-gumbo

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Secret used to sign JWTs. There is no default and the server refuses to
# start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Object storage (any S3-compatible provider)
# ---------------------------------------------------------------------------

# Endpoint of the S3 API. Leave EMPTY for real AWS S3 so the SDK resolves the
# regional endpoint itself. The value below is MinIO from docker-compose.yml.
S3_ENDPOINT=http://127.0.0.1:9000

# MinIO ignores the region but the SDK requires one, so any value works.
# On AWS this must be the bucket's actual region, e.g. ap-south-1.
S3_REGION=us-east-1

# Bucket name. docker-compose.yml creates this one on startup.
# On AWS, create it in the S3 console first.
S3_BUCKET=folder-gumbo

# Credentials. These are MinIO's defaults from docker-compose.yml.
# On AWS these are an IAM user's access key pair (IAM > Users > Security
# credentials), and the user needs read/write on the bucket above.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
